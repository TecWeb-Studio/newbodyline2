<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 400" width="300" height="400" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="bg2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2d2d2d;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a1a1a;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="accent2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#dc2626;stop-opacity:0.3" />
      <stop offset="100%" style="stop-color:#991b1b;stop-opacity:0.1" />
    </linearGradient>
  </defs>
  <rect width="300" height="400" fill="url(#bg2)"/>
  <rect width="300" height="400" fill="url(#accent2)"/>
  <circle cx="150" cy="120" r="45" fill="#dc2626" opacity="0.2"/>
  <circle cx="150" cy="120" r="40" fill="#444444"/>
  <text x="150" y="135" font-size="28" font-weight="bold" fill="#dc2626" text-anchor="middle" font-family="Arial">F</text>
  <rect y="180" width="300" height="220" fill="url(#bg2)"/>
  <text x="150" y="280" font-size="16" fill="#999" text-anchor="middle" font-family="Arial" font-weight="bold">Filippo</text>
</svg>